# Comma-separated stable IDs. Leave empty when no indoor units are installed,
# then add another block for every indoor unit.
ac.instances=living-room,bedroom

# Each air conditioner needs a dedicated UART adapter and a unique Modbus unit ID.
ac.living-room.name=Living room
ac.living-room.device=/dev/serial/by-id/replace-with-living-room-ac-adapter
ac.living-room.baud=9600
ac.living-room.dataBits=8
ac.living-room.stopBits=1
ac.living-room.parity=none
ac.living-room.modbusUnitId=1
ac.living-room.staleAfterSeconds=30
ac.living-room.controllerMac=00:00:00:00:00:00

ac.bedroom.name=Bedroom
ac.bedroom.device=/dev/serial/by-id/replace-with-bedroom-ac-adapter
ac.bedroom.baud=9600
ac.bedroom.dataBits=8
ac.bedroom.stopBits=1
ac.bedroom.parity=none
ac.bedroom.modbusUnitId=2
ac.bedroom.staleAfterSeconds=30
ac.bedroom.controllerMac=00:00:00:00:00:00

# One shared Modbus RTU server UART. Requests are routed by unit ID above.
modbus.device=/dev/serial/by-id/replace-with-rs485-adapter
modbus.baud=9600
modbus.dataBits=8
modbus.stopBits=1
modbus.parity=none

# HTTPS is mandatory. PEM certificate chains and private keys are supported.
web.port=8443
web.tls.certificate=/etc/cool-raspberries/tls/certificate.pem
web.tls.privateKey=/etc/cool-raspberries/tls/private-key.pem
# Set only when the PEM private key is encrypted.
web.tls.privateKeyPassword=

# Comma-separated Basic authentication users. Use a distinct password per user.
web.users=admin,operator
web.user.admin.password=replace-with-a-long-random-password
web.user.operator.password=replace-with-another-long-random-password

# Full RX/TX wire traffic is logged at INFO with hex bytes and decoded meanings.
# FileHandler rotates at this size and retains this many files; increase these
# values if longer traffic retention is required.
log.path=/run/cool-raspberries/gateway.log
log.limitBytes=5000000
log.files=5
