<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Cool Raspberries</title>
  <style>
    body{margin:0;background:#eee;color:#222;font:14px Arial,Helvetica,sans-serif}
    #page{width:760px;max-width:94%;margin:20px auto}
    h1{margin:0 0 16px;padding:12px 15px;background:#24496b;color:#fff;font-size:24px}
    .panel{margin-bottom:16px;border:1px solid #999;background:#fff}
    .panel h2{margin:0;padding:8px 12px;border-bottom:1px solid #999;background:#ddd;font-size:18px}
    table{width:100%;border-collapse:collapse}
    th,td{padding:9px 12px;border-bottom:1px solid #ddd;text-align:left;vertical-align:top}
    tr:last-child th,tr:last-child td{border-bottom:0}
    .status-table th{width:28%;background:#f5f5f5}
    .status-value{font-weight:bold}
    .register-table th{background:#f5f5f5}
    .register-table td:first-child{font-family:monospace;font-weight:bold;white-space:nowrap}
    input,select,button{font:14px Arial,Helvetica,sans-serif;padding:5px;border:1px solid #777;background:#fff}
    input{width:70px}
    button{background:#24496b;color:#fff;font-weight:bold;cursor:pointer}
    .help{color:#555;line-height:1.35}
    .notice{margin:0;padding:10px 12px;color:#555}
    .offline{color:#b00020}.online{color:#087830}
    .refresh{margin:0;padding:10px 12px;border-top:1px solid #999;background:#f5f5f5}
    .selector{margin:0 0 16px;padding:12px;border:1px solid #999;background:#fff}
    .selector label{font-weight:bold;margin-right:8px}
    #result{margin-left:8px}
  </style>
</head>
<body>
  <div id="page">
    <h1>Cool Raspberries</h1>
    {{#hasAirConditioners}}
    <form method="get" action="/" class="selector">
      <label for="ac-selector">Air conditioner</label>
      <select id="ac-selector" name="ac">{{#airConditioners}}<option value="{{id}}"{{#selected}} selected{{/selected}}>{{name}}</option>{{/airConditioners}}</select>
      <button type="submit">View</button>
    </form>
    <div class="panel" id="status-panel">
      <h2>{{acName}} status</h2>
      <table class="status-table">
        <tr><th scope="row">Modbus unit</th><td class="status-value">{{modbusUnitId}}</td></tr>
        <tr><th scope="row">Connection</th><td class="status-value {{connectionClass}}">{{connection}}</td></tr>
        <tr><th scope="row">Power</th><td class="status-value">{{powerStatus}}</td></tr>
        <tr><th scope="row">Temperature</th><td class="status-value">{{temperature}}</td></tr>
        <tr><th scope="row">Sleep timer</th><td class="status-value">{{sleepTimerStatus}} minutes</td></tr>
      </table>
      <form method="get" action="/" class="refresh"><input type="hidden" name="ac" value="{{acId}}"><button type="submit">Refresh status</button></form>
    </div>
    <div class="panel"><p class="notice">HTTPS is observation only. Use Modbus holding registers to control the air conditioner.</p></div>
    {{/hasAirConditioners}}
    {{^hasAirConditioners}}
    <div class="panel" id="empty-panel">
      <h2>No air conditioners configured</h2>
      <p class="notice">The HTTPS gateway and Modbus RTU bus are ready. Add an air conditioner to the gateway configuration when one is available.</p>
    </div>
    {{/hasAirConditioners}}
    <div class="panel" id="modbus-devices">
      <h2>Observed Modbus devices</h2>
      <p class="notice">Valid requests observed since the service started. Unit 0 is a broadcast.</p>
      {{#hasModbusDevices}}
      <table class="register-table">
        <tr><th>Device ID</th><th>Message count</th></tr>
        {{#modbusDevices}}<tr><td>{{unitId}}</td><td>{{messageCount}}</td></tr>{{/modbusDevices}}
      </table>
      {{/hasModbusDevices}}
      {{^hasModbusDevices}}<p class="notice">No Modbus messages observed yet.</p>{{/hasModbusDevices}}
    </div>
    <div class="panel" id="modbus-guide">
      <h2>Modbus register guide</h2>
      <p class="notice">Addresses are zero-based. Some Modbus tools show holding register 0 as 40001 and input register 0 as 30001. Use the Modbus unit shown above for the selected air conditioner.</p>
      <table class="register-table">
        <tr><th>Holding address</th><th>Requested control (read/write)</th><th>Values</th></tr>
        <tr><td>0 / 40001</td><td>Power</td><td>0 = off, 1 = on</td></tr>
        <tr><td>1 / 40002</td><td>Target temperature</td><td>16–31 °C</td></tr>
        <tr><td>2 / 40003</td><td>Sleep timer</td><td>Minutes; 0 disables</td></tr>
      </table>
      <table class="register-table">
        <tr><th>Input address</th><th>Observed status (read-only)</th><th>Values</th></tr>
        <tr><td>0 / 30001</td><td>Power</td><td>0 = off, 1 = on</td></tr>
        <tr><td>1 / 30002</td><td>Measured temperature</td><td>Tenths of a degree Celsius; 235 = 23.5 °C</td></tr>
        <tr><td>2 / 30003</td><td>Remaining sleep timer</td><td>Minutes</td></tr>
      </table>
      <p class="notice">Supported functions: 03 read holding, 04 read input, 06 write one holding, and 16 write multiple holding registers.</p>
    </div>
  </div>
</body>
</html>
