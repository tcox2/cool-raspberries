#!/bin/sh
set -eu

case "${1:-}" in
  configure)
    if ! getent group cool-raspberries >/dev/null; then
      addgroup --system cool-raspberries
    fi
    if ! getent passwd cool-raspberries >/dev/null; then
      adduser --system --ingroup cool-raspberries --home /nonexistent \
        --no-create-home --shell /usr/sbin/nologin cool-raspberries
    fi
    adduser cool-raspberries dialout >/dev/null

    install -d -m 0755 /etc/cool-raspberries
    install -d -m 0750 -o root -g cool-raspberries \
      /etc/cool-raspberries/tls

    if [ ! -e /etc/cool-raspberries/gateway.properties ]; then
      install -m 0640 -o root -g cool-raspberries \
        /usr/share/doc/cool-raspberries/gateway.properties.example \
        /etc/cool-raspberries/gateway.properties
      echo "Created /etc/cool-raspberries/gateway.properties; configure it before starting the service."
    fi

    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable cool-raspberries.service >/dev/null 2>&1 || true
    ;;
esac

exit 0
