exports_files(["rules_jvm_external++maven+maven_install.json"])

java_library(
    name = "gateway",
    srcs = glob(
        ["src/main/java/**/*.java"],
        exclude = ["src/main/java/cr/Main.java"],
    ),
    resources = ["src/main/resources/cr/web/home.mustache"],
    visibility = ["//visibility:private"],
    deps = [
        "@maven//:com_fazecast_jSerialComm",
        "@maven//:com_samskivert_jmustache",
        "@maven//:io_javalin_javalin",
        "@maven//:org_eclipse_jetty_jetty_server",
        "@maven//:org_eclipse_jetty_jetty_util",
        "@maven//:org_slf4j_slf4j_jdk14",
    ],
)

java_binary(
    name = "cool-raspberries",
    srcs = ["src/main/java/cr/Main.java"],
    main_class = "cr.Main",
    visibility = ["//visibility:public"],
    deps = [
        ":gateway",
    ],
)

genrule(
    name = "release-archive",
    srcs = [
        ":cool-raspberries_deploy.jar",
        "README.md",
        "config/gateway.properties.example",
        "deploy/10-cool-raspberries-watchdog.conf",
        "deploy/cool-raspberries.service",
        "scripts/install.sh",
    ],
    outs = ["cool-raspberries.tar.gz"],
    cmd = """
set -eu
staging="$(@D)/release-archive"
package="$$staging/cool-raspberries"
rm -rf "$$staging"
mkdir -p "$$package/config" "$$package/deploy" "$$package/scripts"
cp "$(location :cool-raspberries_deploy.jar)" "$$package/cool-raspberries.jar"
cp "$(location README.md)" "$$package/README.md"
cp "$(location config/gateway.properties.example)" "$$package/config/gateway.properties.example"
cp "$(location deploy/10-cool-raspberries-watchdog.conf)" "$$package/deploy/10-cool-raspberries-watchdog.conf"
cp "$(location deploy/cool-raspberries.service)" "$$package/deploy/cool-raspberries.service"
cp "$(location scripts/install.sh)" "$$package/scripts/install.sh"
chmod 0755 "$$package/scripts/install.sh"
COPYFILE_DISABLE=1 tar -C "$$staging" -czf "$@" cool-raspberries
rm -rf "$$staging"
""",
    visibility = ["//visibility:public"],
)

java_test(
    name = "all-tests",
    srcs = glob(["src/test/java/**/*.java"]),
    resources = glob(["src/test/resources/**"]),
    args = [
        "execute",
        "--select-package=cr",
        "--details=tree",
    ],
    deps = [
        ":gateway",
        "@maven//:org_junit_platform_junit_platform_console_standalone",
    ],
    main_class = "org.junit.platform.console.ConsoleLauncher",
    use_testrunner = False,
)

test_suite(
    name = "tests",
    tests = [":all-tests"],
)
