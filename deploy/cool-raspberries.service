[Unit]
Description=Cool Raspberries AC to Modbus gateway
Documentation=https://github.com/tcox2/cool-raspberries
After=local-fs.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=cool-raspberries
Group=cool-raspberries
SupplementaryGroups=dialout
ExecStart=/usr/bin/java --enable-native-access=ALL-UNNAMED -Xms32m -Xmx128m -XX:+ExitOnOutOfMemoryError -jar /opt/cool-raspberries/cool-raspberries.jar /etc/cool-raspberries/gateway.properties
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
SuccessExitStatus=143

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
